{
  "name": "spicy",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest",
    "dev": "tsx src/index.ts",
    "lint": "eslint",
    "demo": "tsx src/demo.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "pnpm run build && pm2 start dist/index.js --name spicy",
    "log:server": "pm2 logs spicy",
    "restart": "pm2 delete spicy && pnpm run start:server",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "ccxt": "^4.4.92",
    "dotenv": "^17.0.1"
  },
  "engines": {
    "npm": "npmではなく、pnpmを使用してください",
    "yarn": "yarnではなく、pnpmを使用してください"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,md}": [
      "prettier --write"
    ]
  }
}
