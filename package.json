{
  "name": "spicy",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest",
    "dev": "tsx src/apps/arbitrage/index.ts",
    "dev:mm": "tsx src/apps/mm/index.ts",
    "api": "tsx src/apps/arbitrage/server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/apps/arbitrage/demo.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "pnpm run build && pm2 start dist/apps/arbitrage/index.js --name spicy",
    "start:api": "pnpm run build && pm2 start dist/src/server.js --name spicy-api",
    "log:server": "pm2 logs spicy",
    "log:api": "pm2 logs spicy-api",
    "restart": "pm2 delete spicy && pnpm run start:server",
    "restart:api": "pm2 delete spicy-api && pnpm run start:api",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^24.10.9",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "ccxt": "^4.5.35",
    "dotenv": "^17.2.3",
    "ws": "^8.19.0"
  },
  "engines": {
    "npm": "npmではなく、pnpmを使用してください",
    "yarn": "yarnではなく、pnpmを使用してください"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,md}": [
      "prettier --write"
    ]
  }
}
